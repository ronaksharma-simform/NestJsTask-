# Base URL of the NestJS API.
#
# Leave EMPTY when running the Vite dev server (default): vite.config.ts proxies
# /auth and /post to http://localhost:3000, which keeps the accessToken cookie
# same-origin and avoids CORS issues.
#
# Set it to the API origin (e.g. https://api.example.com) when the app is built
# separately from the API. Note: the backend currently responds with CORS
# origin '*' + credentials:true, which browsers reject for credentialed
# cross-origin requests - a real origin must be configured server-side first.
VITE_API_BASE_URL=
